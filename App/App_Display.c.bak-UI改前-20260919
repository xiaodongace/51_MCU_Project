/*
 * 安全的控制器恢复序列 —— 【2026-09-18 新增 · 针对"黑屏后连重启都救不回来"】
 *
 * 真机现象：按键/电位器操作多了之后副屏全黑，而且**按重启按钮也亮不起来**，
 * 只有拔插 USB（给 OLED 断电）才能恢复 ——
 * 说明坏的不是 MCU 里的状态，而是 **OLED 控制器自己的寄存器**（MCU 重启时它一直供电）。
 *
 * 关键补充：只发 0xAF 是救不回来的。因为最可能被写坏的是**电荷泵使能**：
 *     OLED_Init() 里 0xAE 之后紧跟着 0x8D 0x14（开电荷泵）；
 *     一旦序列被打断、停在 0x8D 0x10（关电荷泵）附近，屏幕就是全黑，
 *     此后只发 0xAF 毫无作用 —— 必须重发 0x8D 0x14 才能点亮面板。
 *
 * 所以这里把控制器的**全部关键配置**重发一遍，唯独：
 *   不发 0xAE（关显示）   -> 任何时刻被打断都不会留下黑屏
 *   不清显存              -> 已有画面不会丢
 * 代价只有 16 次字节事务（约 2ms），所以放在每次整屏重画之前，
 * 相当于"每次重画前先把控制器修好再写"。 */
static void sub_safe_recover(void)
{
    I2C_Lock();
    I2C_OLED_WR_Byte(0x8D, I2C_OLED_CMD);   /* 电荷泵使能 */
    I2C_OLED_WR_Byte(0x14, I2C_OLED_CMD);   /*   开启电荷泵  <-- 黑屏救不回来的关键 */
    I2C_OLED_WR_Byte(0xA1, I2C_OLED_CMD);   /* 段重映射 正常 */
    I2C_OLED_WR_Byte(0xC8, I2C_OLED_CMD);   /* COM 扫描方向 正常 */
    I2C_OLED_WR_Byte(0xA6, I2C_OLED_CMD);   /* 正常显示（非反色） */
    I2C_OLED_WR_Byte(0xA8, I2C_OLED_CMD);   /* 复用率 */
    I2C_OLED_WR_Byte(0x3F, I2C_OLED_CMD);   /*   1/64 duty */
    I2C_OLED_WR_Byte(0xD3, I2C_OLED_CMD);   /* 显示偏移 */
    I2C_OLED_WR_Byte(0x00, I2C_OLED_CMD);   /*   0 */
    /* 【2026-09-18 补漏】下面 4 条是拿本序列和 OLED_Init() 逐条比对后补上的，
     * 之前漏掉，导致恢复不完整（尤其是 0xDA，写坏后画面会异常）。 */
    I2C_OLED_WR_Byte(0xD5, I2C_OLED_CMD);   /* 显示时钟分频 / 振荡频率 */
    I2C_OLED_WR_Byte(0x80, I2C_OLED_CMD);
    I2C_OLED_WR_Byte(0xD9, I2C_OLED_CMD);   /* 预充电周期 */
    I2C_OLED_WR_Byte(0xF1, I2C_OLED_CMD);
    I2C_OLED_WR_Byte(0xDA, I2C_OLED_CMD);   /* COM 引脚硬件配置  <-- 写坏会花屏/异常 */
    I2C_OLED_WR_Byte(0x12, I2C_OLED_CMD);
    I2C_OLED_WR_Byte(0xDB, I2C_OLED_CMD);   /* VCOMH 电平 */
    I2C_OLED_WR_Byte(0x40, I2C_OLED_CMD);
    I2C_OLED_WR_Byte(0x81, I2C_OLED_CMD);   /* 对比度 */
    I2C_OLED_WR_Byte(0xCF, I2C_OLED_CMD);
    I2C_OLED_WR_Byte(0x20, I2C_OLED_CMD);   /* 寻址模式 */
    I2C_OLED_WR_Byte(0x02, I2C_OLED_CMD);   /*   页寻址 */
    I2C_OLED_WR_Byte(0x40, I2C_OLED_CMD);   /* 起始行 = 0（治垂直滚动） */
    I2C_OLED_WR_Byte(0xA4, I2C_OLED_CMD);   /* 恢复显示 RAM 内容 */
    I2C_OLED_WR_Byte(0xAF, I2C_OLED_CMD);   /* 开显示 */
    I2C_Unlock();
}

/* 画一行 16 像素高的 ASCII。line 取 0..3，对应页 0/2/4/6。
 *
 * 【2026-09-18 回退说明】
 * 上一版我把这里改成"整页一次事务批量写"（自己拼 256 字节缓冲 + I2C_WriteNbyte(..,128)），
 * 目的是把每行 258 次 I2C 事务降到 4 次、根治"整屏垂直滚动"。
 * 实机结果是副屏整屏乱码、按键对副屏完全无反应 —— 说明批量写这条路径没走通，
 * 而且很可能卡在里面（TASK_RENDER 出不来），连带主屏环境行也不再刷新。
 *
 * 所以回退到驱动自带的 OLED_ShowString（逐字节、已验证能正确显示），
 * 只用总线锁保证不与读时钟交叉。垂直滚动的隐患改用"周期性整屏重画"兜底：
 * 即使某一次被冲乱，最多 3 秒后自动恢复正确画面。 */
static void sub_draw_line(u8 line, const char *s)
{
    /* 【2026-09-19 修正 · 必须固定宽度】
     *
     * 现在副屏的刷新粒度是"只重画变化的那一行"（照 demo30），
     * **一次只写这一行、不做整行清屏**。如果新字符串比上一帧短，
     * 旧内容的尾巴就会留在屏幕上：
     *   真机现象：VOL 从 "VOL 10/10 SONG 1"(15 字) 降到 "VOL 0/10 SONG 1"(14 字) 后
     *             显示成 "VOL 0/10 SONG 11" —— 多出来的那个 1 就是上一帧的残留。
     *
     * demo30 的做法就是固定宽度：`sprintf(strbuff,"Duty:%6.2f%%",...)`（宽度写死）、
     * `"Temp :    C"`（手动补空格）。这里照做：统一补到 16 个字符 = 128 列满宽，
     * 超长则截断。这样每行写入都正好覆盖整行，不会留尾巴。 */
    char padded[18];
    u8 n;
    u8 i;

    n = (u8)strlen(s);
    if (n > 16)
    {
        n = 16;
    }
    for (i = 0; i < n; i++)
    {
        padded[i] = s[i];
    }
    for (; i < 16; i++)
    {
        padded[i] = ' ';
    }
    padded[16] = '\0';

    I2C_Lock();
    I2C_OLED_ShowString(0, (u8)(line * 2), (u8 *)padded, 16);
    I2C_Unlock();
}

static const char *page_name(UIPageId_t p)
{
    switch (p)
    {
    case PAGE_HOME:        return "CLOCK";
    case PAGE_ALARM_LIST:  return "ALARM LIST";
    case PAGE_ALARM_EDIT:  return "ALARM EDIT";
    case PAGE_POMODORO:    return "POMODORO";
    case PAGE_SETTINGS:    return "SETTINGS";
    case PAGE_RINGING:     return "*** RING ***";
    case PAGE_GAME_HALL:   return "GAME HALL";
    case PAGE_GAME_SNAKE:  return "SNAKE";
    case PAGE_GAME_BRICK:  return "BRICK";
    case PAGE_GAME_PLANE:  return "PLANE";
    case PAGE_GAME_DAILY:  return "DAILY";
    case PAGE_GAME_OVER:   return "GAME OVER";
    default:               return "?";
    }
}

/* 星期缩写（副屏只有 ASCII，不能显示汉字） */
static char *week_abbr(u8 w)
{
    switch (w)
    {
    case 0: return "SUN";
    case 1: return "MON";
    case 2: return "TUE";
    case 3: return "WED";
    case 4: return "THU";
    case 5: return "FRI";
    case 6: return "SAT";
    default: return "---";
    }
}

/*
 * 副屏每秒只需要刷"时间那行"。整屏 4 行刷一遍要走 4 x 256 字节 I2C，
 * 约 80~90ms，期间总线锁一直被占着，会把 TASK_LOGIC 读时间卡住。
 * 只刷一行约 20ms，占用降到一个可以接受的水平。
 */
static void sub_draw_clock_line(void)
{
    char buf[24];

    sprintf(buf, "%02d:%02d:%02d %s",
            (int)g_clock.hour, (int)g_clock.minute, (int)g_clock.second,
            week_abbr(g_clock.week));

    sub_draw_line(1, buf);
}

static void sub_full_redraw(void)
{
    char buf[24];
    char buf2[24];

    /* 【2026-09-19 简化】按 demo30 / v3.1 的做法：整屏重画就是"先 Clear 再写字"。
     * 原来我改成了"每行只清自己那两页的尾部"，属于自作聪明，已退回。 */
    I2C_Lock();
    I2C_OLED_Clear();
    I2C_Unlock();

    /* 【2026-09-18 撤掉】这里原来每次重画前都调 sub_safe_recover()，
     * 它含 `0x8D 0x14`（反复开关电荷泵）。但真机证据表明这条路是错的：
     *     [DISP] poll=27000 sub=0 full=14   —— I2C 负载已降到 0.1 次/秒，屏幕照样黑；
     *     按重启按钮不亮（重启会完整重跑 OLED_Init）—— 说明控制器寄存器不是原因；
     *     只有拔插 USB（给模块断电）才恢复     —— 说明是模块内部进了软件复位不了的状态。
     * 所以"反复重配控制器"不但没用，反复动电荷泵还可能是在帮倒忙。
     * 现在回到与 demo30 一致的做法：**只在开机初始化一次 OLED，运行期只写显存**。 */

    sub_draw_line(0, page_name(s_page));

    sprintf(buf, "%02d:%02d:%02d %s",
            (int)g_clock.hour, (int)g_clock.minute, (int)g_clock.second,
            week_abbr(g_clock.week));
    sub_draw_line(1, buf);

    sprintf(buf2, "%04d-%02d-%02d",
            (int)g_clock.year, (int)g_clock.month, (int)g_clock.day);
    sub_draw_line(2, buf2);

    /* 第 4 行：按优先级显示 校时输入中 > 响铃中 > 震动模式 > 音量曲目 */
    sub_build_line3(buf);
    sub_draw_line(3, buf);
}

/* 把第 4 行（最后一行）的内容写进 buf。
 * 单独抽出来是为了让"只刷一行"（s_line3Dirty）能复用同一套优先级逻辑。 */
static void sub_build_line3(char *buf)
{
    if (g_timeEntryCnt > 0)
    {
        sprintf(buf, "SET HHMM: %04u", (unsigned)g_timeEntry);
    }
    else if (Alarm_IsRinging())
    {
        sprintf(buf, "1 STOP 2 SNOOZE");
    }
    else if (g_settings.alert_mode == ALERT_VIBRATE)
    {
        sprintf(buf, "MODE: VIBRATE");
    }
    else
    {
        /* "VOL 6/10" 而不是 "VOL 6" —— 让用户一眼知道满档是多少 */
        /* 【2026-09-18 改为实时值 · 依据用户参考代码】
         * 用户的 demo30/App/App_Motor.c 里是直接显示当前 ADC 换算出来的百分比
         * （sprintf(strbuff,"Duty:%6.2f%%",(adc/2730.00)*100)），
         * 也就是**显示电位器的实时位置**，而不是一个存下来的设置值。
         * 这里照同样的做法：显示 Input_GetPotLevel()（当前旋钮档位）。
         * 原来显示的是 g_settings.volume（掉电保存值，默认 6），
         * 所以开机永远显示 6/10，与旋钮实际位置无关。 */
        /* 【2026-09-19 照 demo30】用百分比显示，不用 "n/10" 档位。
         * demo30/App/App_Motor.c 是这么写的：
         *     sprintf(strbuff, "Duty:%6.2f%%", ((adc / 2730.00) * 100));
         * 这里照同样的思路：旋钮档位 0..10 线性映射成 0..100%。
         * %4d 保证宽度固定（0 和 100 都是 4 位），配合 sub_draw_line 的补空格不会留残影。 */
        sprintf(buf, "VOL%4d%% SONG %d", (int)Input_GetPotLevel() * 10, (int)g_settings.song + 1);
    }
}

