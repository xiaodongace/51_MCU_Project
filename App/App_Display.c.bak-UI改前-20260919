static UIPageId_t s_page = PAGE_HOME;

/* 用于判断"内容变了没有" */
static u8  s_lastMinute  = 0xFF;
static u8  s_lastHour    = 0xFF;
static u8  s_lastDay     = 0xFF;
static u8  s_lastHumi    = 0xFF;
