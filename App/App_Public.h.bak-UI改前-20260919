#define DAY_WED             0x04
#define DAY_THU             0x08
#define DAY_FRI             0x10
#define DAY_SAT             0x20
#define DAY_SUN             0x40
#define DAY_WORKDAY         (DAY_MON | DAY_TUE | DAY_WED | DAY_THU | DAY_FRI)
#define DAY_WEEKEND         (DAY_SAT | DAY_SUN)
#define DAY_ALL             0x7F
#define DAY_NONE            0x00
#define DAY_INVALID         0xFF

/* 音量档位（旋钮 0-10 档） */
#define VOLUME_MIN          0
#define VOLUME_MAX          10

/* 贪睡时长（分钟） */
