/*========================================================================
 *                          公共类型
 *========================================================================*/

/*
 * 一组闹钟。
 * 与 PCF8563 的 Alarm_t 不同：这里是"业务闹钟"，支持任意周几组合；
 * 硬件只有一套闹钟寄存器，由 App_Alarm.c 负责从中挑出最近的一组写进去。
 */
typedef struct
{
    u8 enable;      /* 0=关 1=开 */
    u8 hour;        /* 0-23 */
    u8 minute;      /* 0-59 */
    u8 days;        /* DAY_xxx 掩码，0 表示不响（非法配置） */
    u8 song;        /* 0=用全局设置，1..3=指定曲目 */
} AlarmItem_t;

/* 掉电保存的设置项（存 EEPROM 0 号区，与闹钟同页） */
typedef struct
{
    u16 magic;          /* 校验魔数，用来判断是否首次上电 */
    u8  version;        /* 结构版本，升级时用来兜底 */
    u8  volume;         /* 0-10 */
    u8  alert_mode;     /* ALERT_RING / ALERT_VIBRATE */
    u8  song;           /* 默认曲目 0..2 */
    u8  pomodoro_work;  /* 番茄钟工作时长（分钟） */
    u8  pomodoro_rest;  /* 番茄钟休息时长（分钟） */
    u8  screen_on;      /* 主屏开关 */
    u8  snooze_min;     /* 贪睡分钟数 */
    u8  sunrise_en;     /* 日出唤醒开关 */
    u16 logCount;       /* 温湿度记录已写条数，用来定位写入位置（详见 App_Storage.c） */
    u8  reserved[4];    /* 预留，保持结构尺寸对齐 */
} Settings_t;

/* 设置魔数："AL" + 版本号，用来识别全新芯片 */
#define SETTINGS_MAGIC      0x414C
#define SETTINGS_VERSION    1

