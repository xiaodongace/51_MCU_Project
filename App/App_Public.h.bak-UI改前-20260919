/*========================================================================
 *        I2C 访问请求标志 —— 【2026-09-19 方案 B：全部 I2C 收进一个任务】
 *
 * 参考项目 demo30 的架构：**所有 I2C 访问都在同一个任务里**
 *   （它的 I2C 显示任务里连 RTC 读取都在：`case 3: RTC_show(); break;`）
 * 因为串行，它根本不需要总线锁 —— 也就不会有"锁竞争 → 超时强夺 →
 * 两个任务同时往总线发字节 → 字节流错位 → 花屏/黑屏"这条链。
 *
 * 本工程照此改造：
 *   TASK_LOGIC / 按键 / 串口协议 都不再直接碰 I2C，
 *   只把下面这些标志置 1；由 TASK_RENDER 统一执行真正的 I2C 操作。
 *========================================================================*/
extern volatile bit g_reqClockRefresh;  /* 请求读一次时间（每秒一次） */
extern volatile bit g_reqClockSet;      /* 请求把时间写进时钟芯片（校时） */
extern volatile bit g_reqClockRecover;  /* 请求时钟自救（重设默认时间） */
extern volatile bit g_reqAlarmApply;    /* 请求把硬件闹钟重写一遍 */
extern volatile bit g_reqRtcIrq;        /* 请求处理时钟芯片中断（清标志） */

/*
 * 主界面用矩阵键盘校时的临时状态。
 *   g_timeEntryCnt == 0 表示没在输入；每按一个数字加 1，累计到 4 位就写入芯片。
 *   g_timeEntry 是累计出来的数字（HHMM）。
 * 放全局是为了让 App_Display 能在副屏上回显"输到第几位了"。
 */
extern u16 g_timeEntry;
extern u8  g_timeEntryCnt;

/* 算时间差，自动处理 u32 回绕。用法与 Key_Scan 里的 (now - t0) 完全一致 */
#define SysTick_Elapsed(t0)     (g_sysTick - (u32)(t0))

/*========================================================================
 *              上电进度指示（BOOT_CRUMB）—— 诊断手段
 *
 * 为什么需要它：真机上"三块屏都不亮、按键没反应"时，无法判断程序到底跑到哪一步。
 * 这个宏把 8 颗小灯当成"进度条"：走到第 step 步，就点亮第 1..step 颗灯。
 *
 * 为什么符合规范第四节的硬要求（诊断输出不得依赖被诊断对象）：
 *   它直接写 IO 口，不经过任何任务、不排队、不依赖任何外设初始化，
 *   甚至不依赖 RTX51 跑起来。只要 CPU 还在执行指令，灯就会变。
 *
 * 读法：
 *   亮 k 颗  = sys_init 走到第 k 步就停住了 -> 问题在第 k+1 步
 *   亮 8 颗  = sys_init 全部走通（任务已创建）
 *   只剩第 1 颗亮 = 任务也跑起来了（TASK_LOGIC 初始化完成）
 *   全灭     = 卡在 sys_init 的第 1 步之前
 *
 * 交付正式固件时把 BOOT_CRUMB_ENABLE 改成 0 即可全部去掉。
 *========================================================================*/

#define BOOT_CRUMB_ENABLE   1

#if BOOT_CRUMB_ENABLE
#define BOOT_CRUMB(step)    Boot_Crumb(step)
#else
#define BOOT_CRUMB(step)
#endif

/* step: 1..8；0 表示全灭 */
void Boot_Crumb(u8 step);

/*
 * 按键事件回声（调试用）。打开后：每收到一条按键事件，第 2 颗灯翻转一次，
 * 并往串口打一行 [EVT]。
 *
 * 按键通路已经验证通过，所以默认关闭 —— 否则用户会以为"第 2 颗灯乱闪"是故障。
 * 以后再遇到"按键没反应"时改成 1 即可。
 */
#define DEBUG_EVT_ECHO  0

