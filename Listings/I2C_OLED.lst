  99          //写入一个字节
 100          void Send_Byte(u8 dat)
 101          {
 102   1              u8 i;
 103   1              for(i=0;i<8;i++)
 104   1              {
 105   2                      I2C_OLED_SCL_Clr();//将时钟信号设置为低电平
 106   2                      if(dat&0x80)//将dat的8位从最高位依次写入
 107   2                      {
 108   3                              I2C_OLED_SDA_Set();
 109   3          }
 110   2                      else
 111   2                      {
 112   3                              I2C_OLED_SDA_Clr();
 113   3          }
 114   2                      IIC_delay();
 115   2                      I2C_OLED_SCL_Set();
C51 COMPILER V9.60.7.0   I2C_OLED                                                          09/14/2026 21:08:46 PAGE 3   

 116   2                      IIC_delay();
 117   2                      I2C_OLED_SCL_Clr();
 118   2                      dat<<=1;
 119   2        }
 120   1      }
