 122          #if 0
              //发送一个字节
              //向SSD1306写入一个字节。
              //mode:数据/命令标志 0,表示命令;1,表示数据;
              void I2C_OLED_WR_Byte(u8 dat,u8 mode)
              {
                      I2C_Start();
                      Send_Byte(0x78);
                      I2C_WaitAck();
                      if(mode){Send_Byte(0x40);}
                else{Send_Byte(0x00);}
                      I2C_WaitAck();
                      Send_Byte(dat);
                      I2C_WaitAck();
                      I2C_Stop();
              }
              #endif
 139          
 140          void I2C_OLED_WR_Byte(u8 dat,u8 mode) {
 141   1          if(mode) {
 142   2              I2C_WriteNbyte(0x78, 0x40, &dat, 1);
 143   2          } else {
 144   2              I2C_WriteNbyte(0x78, 0x00, &dat, 1);
 145   2          }
 146   1      }
