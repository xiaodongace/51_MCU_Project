 187          //y:0~63                                 
 188          //sizey:选择字体 6x8  8x16
 189          void I2C_OLED_ShowChar(u8 x,u8 y,u8 chr,u8 sizey)
 190          {       
 191   1              u8 c=0,sizex=sizey/2;
 192   1              u16 i=0,size1;
 193   1              if(sizey==8)size1=6;
 194   1              else size1=(sizey/8+((sizey%8)?1:0))*(sizey/2);
 195   1              c=chr-' ';//得到偏移后的值
 196   1              I2C_OLED_Set_Pos(x,y);
 197   1              for(i=0;i<size1;i++)
 198   1              {
 199   2                      if(i%sizex==0&&sizey!=8) I2C_OLED_Set_Pos(x,y++);
 200   2                      if(sizey==8) I2C_OLED_WR_Byte(asc2_0806[c][i],I2C_OLED_DATA);//6X8字号
 201   2                      else if(sizey==16) I2C_OLED_WR_Byte(asc2_1608[c][i],I2C_OLED_DATA);//8x16字号
 202   2      //              else if(sizey==xx) I2C_OLED_WR_Byte(asc2_xxxx[c][i],I2C_OLED_DATA);//用户添加字号
 203   2                      else return;
 204   2              }
 205   1      }
 206          //m^n函数
 207          u32 I2C_OLED_pow(u8 m,u8 n)
 208          {
 209   1              u32 result=1;    
 210   1              while(n--)result*=m;    
 211   1              return result;
 212   1      }                                 
 213          //显示数字
 214          //x,y :起点坐标
 215          //num:要显示的数字
 216          //len :数字的位数
 217          //sizey:字体大小                  
 218          void I2C_OLED_ShowNum(u8 x,u8 y,u32 num,u8 len,u8 sizey)
 219          {               
 220   1              u8 t,temp,m=0;
 221   1              u8 enshow=0;
 222   1              if(sizey==8)m=2;
 223   1              for(t=0;t<len;t++)
 224   1              {
 225   2                      temp=(num/I2C_OLED_pow(10,len-t-1))%10;
 226   2                      if(enshow==0&&t<(len-1))
 227   2                      {
 228   3                              if(temp==0)
 229   3                              {
 230   4                                      I2C_OLED_ShowChar(x+(sizey/2+m)*t,y,' ',sizey);
 231   4                                      continue;
 232   4                              }else enshow=1;
 233   3                      }
 234   2                      I2C_OLED_ShowChar(x+(sizey/2+m)*t,y,temp+'0',sizey);
 235   2              }
 236   1      }
