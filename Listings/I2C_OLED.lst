 281          static void     I2C_config(void)
 282          {
 283   1              I2C_InitTypeDef         I2C_InitStructure;
 284   1      
 285   1              I2C_InitStructure.I2C_Mode      = I2C_Mode_Master;      //主从选择   I2C_Mode_Master, I2C_Mode_Slave
 286   1              I2C_InitStructure.I2C_Enable    = ENABLE;                       //I2C功能使能,   ENABLE, DISABLE
 287   1              I2C_InitStructure.I2C_MS_WDTA   = DISABLE;                      //主机使能自动发送,  ENABLE, DISABLE
 288   1              I2C_InitStructure.I2C_Speed     = 13;                           //总线速度=Fosc/2/(Speed*2+4),      0~63
 289   1                                                              // 400k, 24M => 13
 290   1              I2C_Init(&I2C_InitStructure);
 291   1              NVIC_I2C_Init(I2C_Mode_Master,DISABLE,Priority_0);      //主从模式, I2C_Mode_Master, I2C_Mode_Slave; 中断使能,
             - ENABLE/DISABLE; 优先级(低到高) Priority_0,Priority_1,Priority_2,Priority_3
 292   1      
 293   1              I2C_SW(I2C_P33_P32);                                    //I2C_P14_P15,I2C_P24_P25,I2C_P33_P32
 294   1      }
